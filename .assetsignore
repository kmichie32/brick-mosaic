# What NOT to serve, when the deployed asset directory is the repo root.
#
# Wrangler installs itself into node_modules at deploy time, so the very
# directory being uploaded grows a 144 MiB `workerd` binary — over Cloudflare's
# 25 MiB per-asset limit, which fails the whole deploy. Everything else here is
# just not web content: it lives on GitHub, it doesn't belong on the site.

node_modules
.git
.claude

test
scripts
docs

CLAUDE.md
README.md
package.json
package-lock.json
bun.lockb
wrangler.jsonc
.assetsignore
.gitignore
preview.png
